{
    "mcpServers": {
        "svelte": {
            "type": "http",
            "url": "https://mcp.svelte.dev/mcp"
        },
        "ai-nurse": {
            "type": "stdio",
            "command": "node",
            "args": ["./mcp-server/build/index.js"],
            "env": {
                "PATIENT_STELLAR_SECRET": "S...",
                "MPP_DEMO_BASE_URL": "http://localhost:5173",
                "STELLAR_NETWORK": "testnet"
            }
        }
    }
}
