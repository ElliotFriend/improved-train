# Run /setup-nurse to populate these (BN254 note pubkey, X25519 encryption pubkey).
A2A_NURSE_NOTE_PUBKEY=""
A2A_NURSE_ENC_PUBKEY=""
# Optional: nurse's X25519 encryption *private* key (0x-prefixed 32 bytes hex).
# When set, verifyPayment will decrypt an output note and assert the amount
# matches A2A_AMOUNT_STROOPS. Without it, only on-chain shape checks run.
# Also produced by /setup-nurse. Keep secret — anyone with this can read all
# notes encrypted to the nurse. (The spending key stays browser-only.)
A2A_NURSE_ENC_PRIVKEY=""

# --- Optional: Claude API key for the nurse reply ---
ANTHROPIC_API_KEY=""
