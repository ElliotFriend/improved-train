# --- A2A demo (Stellar testnet) ---
# Patient + nurse are server-managed testnet accounts. The nurse keypair is
# referenced by stellar-cli alias because withdraw() requires to.require_auth()
# and `stellar contract invoke --source <alias>` handles signing transparently.
A2A_PATIENT_PUBLIC=""        # patient account that deposited the coin
A2A_NURSE_PUBLIC=""          # nurse account that receives withdrawals
A2A_NURSE_ALIAS="a2a_nurse"  # stellar-cli alias for the nurse account
A2A_NETWORK="testnet"
A2A_CACHE_DIR="./.a2a"       # holds coin secrets + state + deployed contract IDs

# --- Optional: Claude API key for the nurse to generate replies ---
# If unset, the nurse endpoint returns a placeholder confirming the payment.
ANTHROPIC_API_KEY=""
