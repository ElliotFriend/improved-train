A2A_NURSE_PUBLIC=""
A2A_NETWORK="testnet"
A2A_AMOUNT_STROOPS="100000000"   # 10 XLM
A2A_POOL_CONTRACT_ID="CAR5DPP35QGWZAYGOHYNGE5WBVI4BXDGT5MRAYYGG6UT64Y4LVKB3EJX"
A2A_ASP_MEMBERSHIP_ID="CDXEYQIMM2TRFDO3E4XSILWEB4GOJXZO7D42KYYQYO4HMFAVBCEDQ2C6"
